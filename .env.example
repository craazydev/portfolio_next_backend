PORT=5000
MONGODB_URI=mongodb://localhost:27017/portfolio
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=changeme123

# Nodemailer (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER=your@email.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Optional Render keep-alive ping
# Example: https://your-backend.onrender.com/api/health
KEEP_ALIVE_URL=https://portfolio-next-backend.onrender.com/api/health
KEEP_ALIVE_INTERVAL_MINUTES=10
